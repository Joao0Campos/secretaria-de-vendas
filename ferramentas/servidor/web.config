<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proxy TLS na frente do painel com IIS - exemplo mínimo.

  Pré-requisitos no IIS: módulos "URL Rewrite" e "Application Request Routing" (ARR).
  No ARR (nível do servidor, "Server Proxy Settings"):
    - marcar "Enable proxy";
    - manter "Preserve client IP in the following header: X-Forwarded-For" (padrão);
    - DESMARCAR "Reverse rewrite host in response headers" (os redirecionamentos do painel já são relativos).
  O site do IIS precisa de binding https com o certificado da empresa.

  No serviço do painel (ver servico-painel.cmd):
    SECRETARIA_PROXY_CONFIAVEL=127.0.0.1   o IP real do cliente vem do X-Forwarded-For
    SECRETARIA_COOKIE_SEGURO=1             cookies Secure + HSTS
    SECRETARIA_HOST fica vazio             (o painel escuta só em 127.0.0.1:8765)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- só https: http vira https -->
        <rule name="Para https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- tudo o mais vai para o painel -->
        <rule name="Painel" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8765/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
